<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TriffView</AssemblyName>
    <RootNamespace>TriffView</RootNamespace>
    <ApplicationIcon>Assets\TriffView.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TriffView.Tests\**" />
    <None Remove="TriffView.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TriffView.Tests" />
    <InternalsVisibleTo Include="TriffView.CycleTests" />
    <InternalsVisibleTo Include="TriffView.PreviewPositionTests" />
    <Compile Remove="TriffView.PreviewPositionTests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hotkeys\TriffViewHotkeys.ahk" LogicalName="TriffView.Hotkeys.TriffViewHotkeys.ahk" />
    <EmbeddedResource Include="Hotkeys\EVE-X-LICENSE.txt" LogicalName="TriffView.Hotkeys.EVE-X-LICENSE.txt" />
    <EmbeddedResource Include="Hotkeys\Runtime\*" LogicalName="TriffView.Hotkeys.%(Filename)%(Extension)" />
    <Resource Include="Assets\TriffView.ico" />
    <EmbeddedResource Include="Assets\overlay-dist.zip"
                      Condition="Exists('Assets\overlay-dist.zip')"
                      LogicalName="TriffView.Assets.overlay-dist.zip" />
  </ItemGroup>
</Project>
